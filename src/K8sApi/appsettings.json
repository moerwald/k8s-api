{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kubernetes": {
    "KubeconfigPath": "/etc/k8s-api/kubeconfig"
  },
  "Keycloak": {
    "Authority": "https://keycloak.example.com/realms/my-realm",
    "Audience": "k8s-api",
    "RequireHttpsMetadata": true
  }
}
